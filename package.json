{
  "name": "cyberquest",
  "version": "0.1.0",
  "description": "CyberQuest — Кібердетектив. Командний квест з кібербезпеки для ITSTEP Academy.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "set CQ_DEV=1&& electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ua.itstep.cyberquest",
    "productName": "CyberQuest",
    "files": ["main.js", "preload.js", "src/**/*", "assets/logo.png"],
    "win": { "target": "portable", "artifactName": "CyberQuest.exe", "signAndEditExecutable": false }
  }
}
